{
   "manifest_version": 3,
   "name": "__MSG_appNameChrome__",
   "description": "__MSG_appDesc__",
   "version": "1.3.0",
   "default_locale": "en",
   "browser_specific_settings": {
      "gecko": {
         "id": "reelslider@sumedhvats",
         "strict_min_version": "109.0"
      }
   },
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png"
      },
      "default_popup": "src/popup/index.html",
      "default_title": "ReelSlider"
   },
   "background": {
      "scripts": [ "assets/worker.js" ],
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "assets/main.ts-loader-CYxjpPse.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "assets/mute-fix.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "assets/reels-timer.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_idle"
   }, {
      "css": [ "src/content/toastStack.css" ],
      "js": [ "assets/bridge.ts-Eb-5j8rm.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_start"
   } ],
   "host_permissions": [ "https://www.instagram.com/*" ],
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "options_page": "src/support/index.html",
   "permissions": [ "storage", "scripting" ],
   "web_accessible_resources": [ {
      "matches": [ "https://www.instagram.com/*" ],
      "resources": [
         "assets/main.ts-loader-CYxjpPse.js",
         "assets/main.ts-CrHNQyXz.js",
         "assets/constants-nW6bUIy2.js",
         "assets/links-CpSuQi2Z.js",
         "assets/featureFlags-BduP1muU.js",
         "assets/telemetry-BwuTmC1U.js",
         "assets/bridge.ts-Eb-5j8rm.js",
         "assets/mute-fix.js",
         "assets/reels-timer.js"
      ]
   } ]
}
